# ITAMS Enterprise — production .env for InfinityFree / Byet.host
# Generated by deploy/infinityfree/build-deploy-package.php.
# Edit the marked values after extracting the ZIP into htdocs/.

APP_NAME="ITAMS Enterprise"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false

# >>> EDIT ME: your free subdomain or custom domain
APP_URL=https://YOUR-USERNAME.infinityfreeapp.com

APP_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# >>> EDIT ME: credentials from Control Panel -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=sqlXXX.epizy.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_itams
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=

# Shared hosting has no Redis -> use database drivers (tables exist via migrations)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

# Email reminders: InfinityFree free blocks SMTP, so keep "log" unless you add a
# Resend API key (resend/resend-laravel) — then use MAIL_MAILER=resend.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# >>> DO NOT CHANGE: generated tokens (see build script output)
APP_SETUP_TOKEN={{SETUP_TOKEN}}
CRON_TOKEN={{CRON_TOKEN}}

VITE_APP_NAME="${APP_NAME}"
